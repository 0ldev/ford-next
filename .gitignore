# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Dados e modelos (não versionar dados brutos/processados nem artefatos treinados)
# Exceção: vin_share.zip é o dataset bruto oficial, comprimido (~38MB), versionado de propósito.
backend/data/raw/*
backend/data/processed/*
!backend/data/raw/.gitkeep
!backend/data/raw/vin_share.zip
!backend/data/processed/.gitkeep
backend/models/*
!backend/models/.gitkeep

# Dado gerado em runtime pela própria API (não pelo pipeline) — ex.: histórico
# de contatos registrados via POST /api/leads/{vin}/contatos.
backend/data/runtime/*
!backend/data/runtime/.gitkeep

# Node / frontend
node_modules/
dist/
frontend/dist/
frontend/coverage/
*.tsbuildinfo

# Ambiente
.env
.env.local
.env.*.local

# Editor / SO
.DS_Store
.vscode/
.idea/
